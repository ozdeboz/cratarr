{
  "name": "cratarr-desktop",
  "productName": "Cratarr",
  "version": "0.15.0",
  "description": "Cratarr's pages in a window of their own: a player that starts at login and keeps playing.",
  "homepage": "https://github.com/ozdeboz/cratarr",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "ozdeboz",
    "email": "9620260+ozdeboz@users.noreply.github.com"
  },
  "private": true,
  "main": "main.js",
  "desktopName": "cratarr.desktop",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "icons": "node copy-icons.js",
    "page": "node copy-page.js",
    "start": "npm run icons && npm run page && electron .",
    "check": "node check-no-house.js",
    "test": "node --test page.test.js",
    "dist": "umask 022 && npm run icons && npm run page && npm run check && electron-builder --linux deb --publish never",
    "dist:win": "npm run icons && npm run page && npm run check && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "org.cratarr.desktop",
    "productName": "Cratarr",
    "afterPack": "./after-pack.js",
    "afterAllArtifactBuild": "./check-deb.js",
    "files": [
      "main.js",
      "page.js",
      "preload.js",
      "setup.html",
      "icons/**"
    ],
    "extraResources": [
      {
        "from": "page",
        "to": "page"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "artifactName": "Cratarr-Setup-${version}.${ext}"
    },
    "linux": {
      "executableName": "cratarr",
      "syncDesktopName": true,
      "icon": "icons/icon-512.png",
      "category": "AudioVideo",
      "synopsis": "Cratarr's pages in a window of their own"
    },
    "deb": {
      "afterInstall": "after-install.tpl",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2"
      ]
    }
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  }
}
