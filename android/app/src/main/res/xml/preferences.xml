<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        android:key="server_url"
        android:title="@string/server_address"
        app:useSimpleSummaryProvider="true" />

    <EditTextPreference
        android:key="player_name"
        android:title="@string/player_name" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="stay_ready"
        android:summary="@string/stay_ready_summary"
        android:title="@string/stay_ready" />

    <Preference
        android:key="battery"
        android:summary="@string/battery_summary"
        android:title="@string/battery" />
</PreferenceScreen>
