{
  "name": "cratarr-web",
  "private": true,
  "version": "0.16.2",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:phone": "node scripts/check-phone.mjs",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --import ./tests/ts-resolve.mjs --test tests/*.test.ts && node --experimental-strip-types --import ./tests/ts-resolve.mjs --test tests/isolated/*.test.ts",
    "e2e:browser": "sh ../scripts/browser-e2e.sh",
    "e2e:standin": "node e2e/standin-run.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/spark-md5": "3.0.5",
    "playwright-core": "1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@jellyfin/sdk": "1.0.1",
    "@xyflow/svelte": "1.7.0",
    "axios": "1.19.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "elkjs": "0.12.0",
    "greet-by-time": "1.0.1",
    "spark-md5": "3.0.2",
    "subsonic-api": "3.4.1"
  }
}
